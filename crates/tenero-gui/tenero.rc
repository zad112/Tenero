// The icon and the version information of tenero-wallet-gui.exe (compiled in by build.rs, on Windows only).
// Keep the version numbers in step with Cargo.toml: FILEVERSION is 0.2.0.3 for 0.2.0-beta.3 (the fourth number counts the beta).
#include <winver.h>

1 ICON "../../assets/tenero.ico"

1 VERSIONINFO
FILEVERSION 0,2,0,3
PRODUCTVERSION 0,2,0,3
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", "Tenero\0"
            VALUE "FileDescription", "Tenero wallet app (experimental, unaudited, no value)\0"
            VALUE "FileVersion", "0.2.0-beta.3\0"
            VALUE "ProductVersion", "0.2.0-beta.3\0"
            VALUE "LegalCopyright", "BSD-3-Clause, see LICENSE\0"
            VALUE "OriginalFilename", "tenero-wallet-gui.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
